def ext.days_from_civil
  (y : Std.I64) (m : Std.I64) (d : Std.I64) : Result Std.I64 := do
  let y1 ← if m > 2#i64
             then ok y
             else y - 1#i64
  let y11 ← if y1 >= 0#i64
              then ok y1
              else y1 - 399#i64
  let era ← ext.tdiv y11 400#i64
  let i ← era * 400#i64
  let yoe ← y1 - i
  let mp ← if m > 2#i64
             then m - 3#i64
             else m + 9#i64
  let i1 ← 153#i64 * mp
  let i2 ← i1 + 2#i64
  let i3 ← ext.tdiv i2 5#i64
  let i4 ← i3 + d
  let doy ← i4 - 1#i64
  let i5 ← yoe * 365#i64
  let i6 ← ext.tdiv yoe 4#i64
  let i7 ← i5 + i6
  let i8 ← ext.tdiv yoe 100#i64
  let i9 ← i7 - i8
  let doe ← i9 + doy
  let i10 ← era * 146097#i64
  let i11 ← i10 + doe
  i11 - 719468#i64


  | value.List.Nil => ok (expr.Expr.Lit (value.Prim.Bool true))
  | value.List.Cons c rest =>
    match rest with
    | value.List.Nil => policy.condition_to_expr c
    | value.List.Cons _ _ =>
      let e ← policy.condition_to_expr c
      let e1 ← policy.conditions_to_expr rest

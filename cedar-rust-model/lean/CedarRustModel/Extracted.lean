    Visibility: public -/
def policy.policy_to_expr (p : policy.LinkedPolicy) : Result expr.Expr := do
  let e ← policy.scope_to_expr p.principal_scope expr.Var.Principal
  let e1 ← policy.action_scope_to_expr p.action_scope
  let e2 ← policy.scope_to_expr p.resource_scope expr.Var.Resource
  let e3 ← policy.conditions_to_expr p.condition
  let e4 ← policy.mk_and e2 e3
  let e5 ← policy.mk_and e1 e4
  policy.mk_and e e5


                       ok (expr.Expr.Lit p1)
  | expr.Expr.Var v => let v1 ← policy.clone_var v
                       ok (expr.Expr.Var v1)
  | expr.Expr.Ite x1 x2 x3 =>
    let e ← policy.clone_expr x1
    let e1 ← policy.clone_expr x2
    let e2 ← policy.clone_expr x3
    ok (expr.Expr.Ite e e1 e2)
  | expr.Expr.And x1 x2 =>
    let e ← policy.clone_expr x1
    let e1 ← policy.clone_expr x2
    ok (expr.Expr.And e e1)
  | expr.Expr.Or x1 x2 =>
    let e ← policy.clone_expr x1
    let e1 ← policy.clone_expr x2
    ok (expr.Expr.Or e e1)
  | expr.Expr.UnaryApp o x1 =>
    let uo ← policy.clone_unary_op o
    let e ← policy.clone_expr x1
    ok (expr.Expr.UnaryApp uo e)
  | expr.Expr.BinaryApp o x1 x2 =>
    let bo ← policy.clone_binary_op o
    let e ← policy.clone_expr x1
    let e1 ← policy.clone_expr x2
    ok (expr.Expr.BinaryApp bo e e1)
  | expr.Expr.GetAttr x1 a =>
    let e ← policy.clone_expr x1
    let l ← value.clone_str a
    ok (expr.Expr.GetAttr e l)
  | expr.Expr.HasAttr x1 a =>
    let e ← policy.clone_expr x1
    let l ← value.clone_str a
    ok (expr.Expr.HasAttr e l)
  | expr.Expr.ExtHasAttr x1 a attrs =>
    let e ← policy.clone_expr x1
    let l ← value.clone_str a
    let l1 ← value.clone_strs attrs
    ok (expr.Expr.ExtHasAttr e l l1)
  | expr.Expr.Set xs => let l ← policy.clone_exprs xs
                        ok (expr.Expr.Set l)
  | expr.Expr.Record axs =>
    let l ← policy.clone_attr_exprs axs
    ok (expr.Expr.Record l)

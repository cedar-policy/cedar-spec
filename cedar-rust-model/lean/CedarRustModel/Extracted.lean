      | expr.Expr.ExtHasAttr _ _ _ => ok (expr.Expr.And x1 x2)
      | expr.Expr.Set _ => ok (expr.Expr.And x1 x2)
      | expr.Expr.Record _ => ok (expr.Expr.And x1 x2)
      | expr.Expr.Call _ _ => ok (expr.Expr.And x1 x2)
    | value.Prim.Int _ => ok (expr.Expr.And x1 x2)
    | value.Prim.String _ => ok (expr.Expr.And x1 x2)
    | value.Prim.EntityUID _ => ok (expr.Expr.And x1 x2)
  | expr.Expr.Var _ => ok (expr.Expr.And x1 x2)
  | expr.Expr.Ite _ _ _ => ok (expr.Expr.And x1 x2)
  | expr.Expr.And _ _ => ok (expr.Expr.And x1 x2)

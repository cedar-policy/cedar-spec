      | none => ok none
      | some parts =>
        let neg ← ext.starts_with s '-'
        let o1 ← ext.dur_quantity parts.d
        let o2 ← ext.dur_quantity parts.h
        let o3 ← ext.dur_quantity parts.m
        let o4 ← ext.dur_quantity parts.s
        let o5 ← ext.dur_quantity parts.ms
        match o1 with
        | none => ok none
        | some d =>
          match o2 with
          | none => ok none
          | some h =>
            match o3 with
            | none => ok none
            | some m =>
              match o4 with
              | none => ok none
              | some sec =>
                match o5 with
                | none => ok none
                | some ms =>
                  let ms0 ← ext.dur_init ms neg
                  match ms0 with
                  | none => ok none
                  | some a0 =>
                    let o6 ← ext.dur_step a0 sec 1000#i64 neg
                    match o6 with
                    | none => ok none

def authorizer.satisfied
  (p : authorizer.Policy) (req : request.Request)
  (es : value.List (value.EntityUID × entities.EntityData)) :
  Result Bool
  := do
  let r ← evaluator.evaluate p.condition req es
  match r with
  | core.result.Result.Ok v =>
    match v with
    | value.Value.Prim p1 =>
      match p1 with
      | value.Prim.Bool b => if b
                             then ok true
                             else ok false
      | value.Prim.Int _ => ok false
      | value.Prim.String _ => ok false
      | value.Prim.EntityUID _ => ok false
    | value.Value.Set _ => ok false
    | value.Value.Record _ => ok false
    | value.Value.Ext _ => ok false
  | core.result.Result.Err _ => ok false


      | expr.Expr.Ite _ _ _ => ok (expr.Expr.And x1 x2)
      | expr.Expr.And _ _ => ok (expr.Expr.And x1 x2)
      | expr.Expr.Or _ _ => ok (expr.Expr.And x1 x2)
      | expr.Expr.UnaryApp _ _ => ok (expr.Expr.And x1 x2)
      | expr.Expr.BinaryApp _ _ _ => ok (expr.Expr.And x1 x2)
      | expr.Expr.GetAttr _ _ => ok (expr.Expr.And x1 x2)

    Source: 'src/authorizer.rs', lines 130:0-146:1
    Visibility: public -/
def authorizer.is_authorized
  (req : request.Request)
  (es : value.List (value.EntityUID × entities.EntityData))
  (ps : value.List authorizer.Policy) :
  Result authorizer.Response
  := do
  let l ← authorizer.satisfied_policies false ps req es
  let forbids ← value.strs_canonicalize l
  let l1 ← authorizer.satisfied_policies true ps req es
  let permits ← value.strs_canonicalize l1
  let l2 ← authorizer.error_policies ps req es
  let erroring_policies ← value.strs_canonicalize l2
  match forbids with
  | value.List.Nil =>
    match permits with
    | value.List.Nil =>
      ok
        {
          decision := authorizer.Decision.Deny,
          determining_policies := value.List.Nil,
          erroring_policies
        }
    | value.List.Cons _ _ =>
      ok
        {
          decision := authorizer.Decision.Allow,
          determining_policies := permits,
          erroring_policies
        }
  | value.List.Cons _ _ =>
    ok
      {
        decision := authorizer.Decision.Deny,
        determining_policies := forbids,
        erroring_policies
      }


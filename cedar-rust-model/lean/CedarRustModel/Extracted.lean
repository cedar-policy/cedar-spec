def policy.to_policy (p : policy.LinkedPolicy) : Result authorizer.Policy := do
  let l ← value.clone_str p.id
  let e ← policy.clone_effect p.effect
  let e1 ← policy.policy_to_expr p
  ok { id := l, effect := e, condition := e1 }


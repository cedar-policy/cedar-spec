def evaluator.evaluate_list
  (xs : value.List expr.Expr) (req : request.Request)
  (es : value.List (value.EntityUID × entities.EntityData)) :
  Result (core.result.Result (value.List value.Value) value.Error)
  := do
  match xs with
  | value.List.Nil => ok (core.result.Result.Ok value.List.Nil)
  | value.List.Cons x rest =>
    let r ← evaluator.evaluate x req es
    match r with
    | core.result.Result.Ok v =>
      let r1 ← evaluator.evaluate_list rest req es
      match r1 with
      | core.result.Result.Ok vs =>
        ok (core.result.Result.Ok (value.List.Cons v vs))
      | core.result.Result.Err _ => ok r1
    | core.result.Result.Err e => ok (core.result.Result.Err e)

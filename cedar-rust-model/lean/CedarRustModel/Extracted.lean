def evaluator.evaluate
  (x : expr.Expr) (req : request.Request)
  (es : value.List (value.EntityUID × entities.EntityData)) :
  Result (core.result.Result value.Value value.Error)
  := do
  match x with
  | expr.Expr.Lit p =>
    let p1 ← value.clone_prim p
    ok (core.result.Result.Ok (value.Value.Prim p1))
  | expr.Expr.Var v =>
    match v with
    | expr.Var.Principal =>
      let eu ← value.clone_uid req.principal
      ok (core.result.Result.Ok (value.Value.Prim (value.Prim.EntityUID eu)))
    | expr.Var.Action =>
      let eu ← value.clone_uid req.action
      ok (core.result.Result.Ok (value.Value.Prim (value.Prim.EntityUID eu)))
    | expr.Var.Resource =>
      let eu ← value.clone_uid req.resource
      ok (core.result.Result.Ok (value.Value.Prim (value.Prim.EntityUID eu)))
    | expr.Var.Context =>
      let l ← value.clone_attrs req.context
      ok (core.result.Result.Ok (value.Value.Record l))
  | expr.Expr.Ite x1 x2 x3 =>
    let r ← evaluator.evaluate x1 req es
    let r1 ← evaluator.as_bool r
    match r1 with
    | core.result.Result.Ok b =>
      if b
      then evaluator.evaluate x2 req es
      else evaluator.evaluate x3 req es
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | expr.Expr.And x1 x2 =>
    let r ← evaluator.evaluate x1 req es
    let r1 ← evaluator.as_bool r
    match r1 with
    | core.result.Result.Ok b =>
      if b
      then
        let r2 ← evaluator.evaluate x2 req es
        let r3 ← evaluator.as_bool r2
        match r3 with
        | core.result.Result.Ok b1 =>
          let v ← evaluator.bool_val b1
          ok (core.result.Result.Ok v)
        | core.result.Result.Err e => ok (core.result.Result.Err e)
      else let v ← evaluator.bool_val false
           ok (core.result.Result.Ok v)
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | expr.Expr.Or x1 x2 =>
    let r ← evaluator.evaluate x1 req es
    let r1 ← evaluator.as_bool r
    match r1 with
    | core.result.Result.Ok b =>
      if b
      then let v ← evaluator.bool_val true
           ok (core.result.Result.Ok v)
      else
        let r2 ← evaluator.evaluate x2 req es
        let r3 ← evaluator.as_bool r2
        match r3 with
        | core.result.Result.Ok b1 =>
          let v ← evaluator.bool_val b1
          ok (core.result.Result.Ok v)
        | core.result.Result.Err e => ok (core.result.Result.Err e)
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | expr.Expr.UnaryApp op x1 =>
    let r ← evaluator.evaluate x1 req es
    match r with
    | core.result.Result.Ok v1 => evaluator.apply1 op v1
    | core.result.Result.Err _ => ok r
  | expr.Expr.BinaryApp op x1 x2 =>
    let r ← evaluator.evaluate x1 req es
    match r with
    | core.result.Result.Ok v1 =>
      let r1 ← evaluator.evaluate x2 req es
      match r1 with
      | core.result.Result.Ok v2 => evaluator.apply2 op v1 v2 es
      | core.result.Result.Err _ => ok r1
    | core.result.Result.Err _ => ok r
  | expr.Expr.GetAttr x1 a =>
    let r ← evaluator.evaluate x1 req es
    match r with
    | core.result.Result.Ok v1 => evaluator.get_attr v1 a es
    | core.result.Result.Err _ => ok r
  | expr.Expr.HasAttr x1 a =>
    let r ← evaluator.evaluate x1 req es
    match r with
    | core.result.Result.Ok v1 => evaluator.has_attr v1 a es
    | core.result.Result.Err _ => ok r
  | expr.Expr.ExtHasAttr x1 a attrs =>
    let r ← evaluator.evaluate x1 req es
    match r with
    | core.result.Result.Ok v1 =>
      let l ← value.clone_str a
      let l1 ← value.clone_strs attrs
      evaluator.has_attrs v1 (value.List.Cons l l1) es
    | core.result.Result.Err _ => ok r
  | expr.Expr.Set xs =>
    let r ← evaluator.evaluate_list xs req es
    match r with
    | core.result.Result.Ok vs =>
      let l ← value.values_canonicalize vs
      ok (core.result.Result.Ok (value.Value.Set l))
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | expr.Expr.Record axs =>
    let r ← evaluator.evaluate_attrs axs req es
    match r with
    | core.result.Result.Ok avs =>
      let l ← value.attrs_canonicalize avs
      ok (core.result.Result.Ok (value.Value.Record l))
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | expr.Expr.Call f xs =>
    let r ← evaluator.evaluate_list xs req es
    match r with
    | core.result.Result.Ok vs => evaluator.call_ext f vs
    | core.result.Result.Err e => ok (core.result.Result.Err e)

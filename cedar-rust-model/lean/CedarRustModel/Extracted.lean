def ext.call_string
  (f : ext.ExtFun) (args : value.List value.Value) :
  Result (core.result.Result ext.ExtRes value.Error)
  := do
  let o ← ext.one_arg args
  match o with
  | none => ok (core.result.Result.Err value.Error.TypeError)
  | some v =>
    match v with
    | value.Value.Prim p =>
      match p with
      | value.Prim.Bool _ => ok (core.result.Result.Err value.Error.TypeError)
      | value.Prim.Int _ => ok (core.result.Result.Err value.Error.TypeError)
      | value.Prim.String s =>
        match f with
        | ext.ExtFun.Decimal =>
          let o1 ← ext.parse_decimal s
          let o2 ←
            match o1 with
            | none => ok none
            | some d => ok (some (ext.Ext.Decimal d))
          ext.ext_or_err o2
        | ext.ExtFun.LessThan =>
          ok (core.result.Result.Err value.Error.TypeError)
        | ext.ExtFun.LessThanOrEqual =>
          ok (core.result.Result.Err value.Error.TypeError)
        | ext.ExtFun.GreaterThan =>
          ok (core.result.Result.Err value.Error.TypeError)
        | ext.ExtFun.GreaterThanOrEqual =>
          ok (core.result.Result.Err value.Error.TypeError)
        | ext.ExtFun.Ip =>
          let o1 ← ext.parse_ip s
          let o2 ←
            match o1 with
            | none => ok none
            | some a => ok (some (ext.Ext.IPAddr a))
          ext.ext_or_err o2
        | ext.ExtFun.IsIpv4 =>
          ok (core.result.Result.Err value.Error.TypeError)
        | ext.ExtFun.IsIpv6 =>
          ok (core.result.Result.Err value.Error.TypeError)
        | ext.ExtFun.IsLoopback =>
          ok (core.result.Result.Err value.Error.TypeError)
        | ext.ExtFun.IsMulticast =>
          ok (core.result.Result.Err value.Error.TypeError)
        | ext.ExtFun.IsInRange =>
          ok (core.result.Result.Err value.Error.TypeError)
        | ext.ExtFun.Datetime =>
          let o1 ← ext.parse_datetime s
          let o2 ←
            match o1 with
            | none => ok none
            | some d => ok (some (ext.Ext.Datetime d))
          ext.ext_or_err o2
        | ext.ExtFun.Duration =>
          let o1 ← ext.parse_duration s
          let o2 ←
            match o1 with
            | none => ok none
            | some d => ok (some (ext.Ext.Duration d))
          ext.ext_or_err o2
        | ext.ExtFun.Offset =>
          ok (core.result.Result.Err value.Error.TypeError)
        | ext.ExtFun.DurationSince =>
          ok (core.result.Result.Err value.Error.TypeError)
        | ext.ExtFun.ToDate =>
          ok (core.result.Result.Err value.Error.TypeError)
        | ext.ExtFun.ToTime =>
          ok (core.result.Result.Err value.Error.TypeError)
        | ext.ExtFun.ToMilliseconds =>
          ok (core.result.Result.Err value.Error.TypeError)
        | ext.ExtFun.ToSeconds =>
          ok (core.result.Result.Err value.Error.TypeError)
        | ext.ExtFun.ToMinutes =>
          ok (core.result.Result.Err value.Error.TypeError)
        | ext.ExtFun.ToHours =>
          ok (core.result.Result.Err value.Error.TypeError)
        | ext.ExtFun.ToDays =>
          ok (core.result.Result.Err value.Error.TypeError)
      | value.Prim.EntityUID _ =>
        ok (core.result.Result.Err value.Error.TypeError)
    | value.Value.Set _ => ok (core.result.Result.Err value.Error.TypeError)
    | value.Value.Record _ => ok (core.result.Result.Err value.Error.TypeError)
    | value.Value.Ext _ => ok (core.result.Result.Err value.Error.TypeError)


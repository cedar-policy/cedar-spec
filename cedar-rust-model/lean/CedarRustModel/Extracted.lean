def ext.parse_time (s : value.List Char) : Result (Option Std.I64) := do
  let o ← ext.match_hms s
  match o with
  | none => ok none
  | some t =>
    let (hs, mis, ss, rest) := t
    let o1 ← ext.match_ms_offset rest
    match o1 with
    | none => ok none
    | some p =>
      let (msopt, off) := p
      let h ← ext.small_nat hs
      let mi ← ext.small_nat mis
      let sec ← ext.small_nat ss
      let ms ← ext.opt_small_nat msopt
      let o2 ← ext.offset_delta off
      match o2 with
      | none => ok none
      | some dl =>
        if h < 24#i64
        then
          if mi < 60#i64
          then
            if sec < 60#i64
            then
              let i ← h * 3600#i64
              let i1 ← mi * 60#i64
              let i2 ← i + i1
              let i3 ← i2 + sec
              let i4 ← i3 * 1000#i64
              let i5 ← i4 + ms
              let i6 ← dl * 1000#i64
              let i7 ← i5 + i6
              ok (some i7)
            else ok none
          else ok none
        else ok none


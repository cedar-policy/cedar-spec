def evaluator.evaluate_attrs
  (axs : value.List ((value.List Char) × expr.Expr)) (req : request.Request)
  (es : value.List (value.EntityUID × entities.EntityData)) :
  Result (core.result.Result (value.List ((value.List Char) × value.Value))
    value.Error)
  := do
  match axs with
  | value.List.Nil => ok (core.result.Result.Ok value.List.Nil)
  | value.List.Cons p rest =>
    let (a, x) := p
    let r ← evaluator.evaluate x req es
    match r with
    | core.result.Result.Ok v =>
      let r1 ← evaluator.evaluate_attrs rest req es
      match r1 with
      | core.result.Result.Ok avs =>
        let l ← value.clone_str a
        ok (core.result.Result.Ok (value.List.Cons (l, v) avs))
      | core.result.Result.Err _ => ok r1
    | core.result.Result.Err e => ok (core.result.Result.Err e)

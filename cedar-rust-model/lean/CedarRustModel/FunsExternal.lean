/-- [cedar_rust_model::value::char_lt]: `(c as u32) < (d as u32)` -/
def value.char_lt (c d : Char) : Result Bool := ok (decide (c.val < d.val))

/-- [cedar_rust_model::ext::char_code]: `c as u32` -/
def ext.char_code (c : Char) : Result Std.U32 := ok ⟨c.val.toBitVec⟩


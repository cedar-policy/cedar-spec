/-- Raw flat parser tables (no closures); the inline engine `Exec.runInline`
    reads these directly. `table` below is definitionally these same arrays
    wrapped as `ExecTable` closures, kept for the refinement witness. -/
def flat : Runtime.Exec.FlatTable V := {
  numStates := 221
  startState := 0
  eof := decode .EOF
  actWidth := 52
  gotoWidth := 53
  actionData := actionData
  gotoData := gotoData
  defRedData := defRedData
  lhsData := lhsData
  lenData := lenData
  sem := sem
  redv := redv
}

/-- The closure `ExecTable` the refinement witness is stated against. -/
def table : Runtime.Exec.ExecTable V := flat.toExecTable

/-- The direct-stack `redv` equals the `popN`+`sem` composite, production by
    production. Feeds `Runtime.Exec.reduceRedv_eq`/`runRedv_eq_run`. -/
theorem redvMatches (p : Nat) (stk : Runtime.Exec.Stack V) :
    flat.redv p stk = Runtime.Exec.popNsem flat p stk := by
  show redv p stk = Runtime.Exec.popNsem flat p stk
  unfold Runtime.Exec.popNsem
  fun_cases redv p <;> simp only [redv] <;> (first | rfl | (split <;> rfl))

/-- Run the parser with full accept/reject/timeout/error detail. -/
@[export cedar_frontend_parsers_policyparser_run]
def run (input : List Tok) (logNSteps : Nat := 20) : Runtime.Exec.Result V :=
  Runtime.Exec.runRedv flat (input.map decode) logNSteps

/-- Parse a finite token list, padding exhausted input with `EOF`. -/
@[export cedar_frontend_parsers_policyparser_parse]
def parse (input : List Tok) (logNSteps : Nat := 20) : Option Policies :=
  match run input logNSteps with
  | .ok (.v0 r) => some r
  | _ => none

end Cedar.Frontend.Parsers.PolicyParser


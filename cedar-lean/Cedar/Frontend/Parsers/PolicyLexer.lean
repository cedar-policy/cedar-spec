/-- The compiled lexer callers use. Its DFAs are the emitted, validated tables
    (`dfa{m}`); only the action closures come from the rule list. -/
def Cedar.Frontend.Parsers.PolicyLexer.lexer : Lexer.Compiled Tok :=
  { dfas := #[Cedar.Frontend.Parsers.PolicyLexer.dfa0]
  , acts := (Cedar.Frontend.Parsers.PolicyLexer.tokenizer).modes.map (fun rules => (rules.map (·.act)).toArray)
  , start := (Cedar.Frontend.Parsers.PolicyLexer.tokenizer).start
  , eofToken := (Cedar.Frontend.Parsers.PolicyLexer.tokenizer).eofToken }

/-- The flat `state × class` tables (one per mode), built offline from the DFAs.
    These are the fast scanner's tables; `flatValidated{m}` checks each agrees
    with its DFA, so `tokenizeFlatStr` is proved equal to the spec `tokenize`
    (`Lexer.tokenizeFlatStr_eq_tokenize`). -/
def Cedar.Frontend.Parsers.PolicyLexer.cflat : Lexer.CompiledFlat Tok :=
  { base := Cedar.Frontend.Parsers.PolicyLexer.lexer
  , flats := #[Lexer.DFA.flatOfDFA Cedar.Frontend.Parsers.PolicyLexer.dfa0]
  , textDep := #[#[false, false, false, false, true, true, true, true, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false]] }

/-- A-posteriori validation of mode 0's flat `state × class` tables. -/
theorem Cedar.Frontend.Parsers.PolicyLexer.flatValidated0 :
    Lexer.flatValidate (Cedar.Frontend.Parsers.PolicyLexer.cflat.flats.getD 0 default)
      (Cedar.Frontend.Parsers.PolicyLexer.cflat.base.dfas.getD 0 default) = true := by native_decide

/-- Tokenize an input string. Uses the fast flat `state × class` scanner over
    `String.Pos` (`Lexer.tokenizeFlatStr`: `DFA.flatScanStr` + `String.extract`,
    no `List Char`), proved equal to the spec `Lexer.tokenize`
    (`Lexer.tokenizeFlatStr_eq_tokenize`, using the `flatValidated{m}` checks), so
    `tokenize_sound` transfers. -/
def Cedar.Frontend.Parsers.PolicyLexer.tokenize (input : String) : Except Lexer.LexError (List Tok) :=
  Lexer.tokenizeFlatStr Cedar.Frontend.Parsers.PolicyLexer.cflat input
